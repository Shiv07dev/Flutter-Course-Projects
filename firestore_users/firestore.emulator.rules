rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Local emulator rules for fictional course data. Do not deploy these rules.
    match /users/{userId} {
      function validUser() {
        return request.resource.data.keys().hasOnly(['name', 'city'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.city is string
          && request.resource.data.city.size() > 0
          && request.resource.data.city.size() <= 150;
      }
      allow read, delete: if true;
      allow create, update: if validUser();
    }
  }
}
